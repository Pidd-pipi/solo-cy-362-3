# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name 为空
COMPOSE_PROJECT_NAME=ldmurdergame

# 数据库账号配置
DB_NAME=app
DB_USER=app
DB_PASSWORD=app_pwd
DB_ROOT_PASSWORD=root_pwd

# JWT 签名密钥，生产环境请替换为随机长字符串
JWT_SECRET=change_me_to_a_long_random_string

# 宿主机端口映射（如遇端口冲突可修改）
FRONTEND_PORT=28502
BACKEND_PORT=29502
DB_PORT=5432
